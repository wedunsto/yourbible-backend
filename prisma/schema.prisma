generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bible_study_notes {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  book             String
  chapter          Int
  verses           String
  study_categories String[]
  title            String
  notes            String
  study_date       DateTime @db.Date
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
}

model users {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                    String   @unique
  password                    String
  account_status              String   @default("NEW")
  created_at                  DateTime @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime @default(now()) @db.Timestamptz(6)
  onboarded                   Boolean  @default(false)
  recommendation_requests     Int      @default(0)
  last_recommendation_request DateTime @default(now()) @db.Timestamptz(6)
}

model bible_study_categories {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  category   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}
