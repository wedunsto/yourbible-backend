generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bible_study_notes {
  id               String   @id @default(dbgenerated("nextval('bible_study_notes_id_seq'::regclass)"))
  book             String
  chapter          Int
  verses           String
  study_categories String[]
  title            String
  notes            String
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  username         String?
}

model users {
  id                          BigInt    @id @default(autoincrement())
  username                    String    @unique
  password                    String
  account_status              String    @default("NEW")
  created_at                  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime  @default(now()) @db.Timestamptz(6)
  recommendation_requests     Int?
  last_recommendation_request DateTime? @db.Date
}
